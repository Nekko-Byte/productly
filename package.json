    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,sass,less,json,md}\"",
    "precommit": "npm run lint && npm run format"
